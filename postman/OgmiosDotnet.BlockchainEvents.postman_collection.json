{
  "info": {
    "_postman_id": "blockchain-events-dapr",
    "name": "OgmiosDotnet.BlockchainEvents - Dapr Sidecar API",
    "description": "Demonstrates direct Dapr sidecar HTTP calls for SDK-less consumption.\n\nThis collection proves that any language can consume blockchain events by calling the Dapr sidecar directly - no Ogmios SDK or Dapr SDK required.\n\nMilestone 2 adds gRPC streaming, OpenAPI/Swagger, and redelivery scenarios.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "dapr_host",
      "value": "localhost"
    },
    {
      "key": "dapr_http_port",
      "value": "3500"
    },
    {
      "key": "pubsub_name",
      "value": "pubsub"
    },
    {
      "key": "topic_name",
      "value": "cardano-transactions"
    },
    {
      "key": "statestore_name",
      "value": "statestore"
    },
    {
      "key": "secretstore_name",
      "value": "secretstore"
    },
    {
      "key": "worker_host",
      "value": "localhost"
    },
    {
      "key": "worker_http_port",
      "value": "4000"
    },
    {
      "key": "grpc_port",
      "value": "4010"
    }
  ],
  "item": [
    {
      "name": "Health & Metadata",
      "item": [
        {
          "name": "Sidecar Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://{{dapr_host}}:{{dapr_http_port}}/v1.0/healthz",
              "protocol": "http",
              "host": ["{{dapr_host}}"],
              "port": "{{dapr_http_port}}",
              "path": ["v1.0", "healthz"]
            },
            "description": "Check if the Dapr sidecar is healthy and ready to accept requests."
          },
          "response": []
        },
        {
          "name": "Sidecar Metadata",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://{{dapr_host}}:{{dapr_http_port}}/v1.0/metadata",
              "protocol": "http",
              "host": ["{{dapr_host}}"],
              "port": "{{dapr_http_port}}",
              "path": ["v1.0", "metadata"]
            },
            "description": "Get metadata about the Dapr sidecar including registered components."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Pub/Sub - Publishing Events",
      "item": [
        {
          "name": "Publish Transaction Event (CloudEvents)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"specVersion\": \"1.0\",\n  \"id\": \"test-tx-123-governance-1706180400000\",\n  \"source\": \"cardano://preprod/slot/12345678/block/abc123def456\",\n  \"type\": \"io.cardano.transaction.governance-treasury\",\n  \"subject\": \"Governance & Treasury\",\n  \"time\": \"2026-01-25T10:00:00Z\",\n  \"dataContentType\": \"application/json\",\n  \"data\": {\n    \"transactionId\": \"test-tx-123\",\n    \"slot\": 12345678,\n    \"blockHeight\": 9876543,\n    \"blockHash\": \"abc123def456\",\n    \"ruleId\": \"governance-treasury\",\n    \"ruleName\": \"Governance & Treasury\",\n    \"matchedCriteria\": {\n      \"match_types\": \"governance\"\n    },\n    \"transaction\": {\n      \"id\": \"test-tx-123\",\n      \"slot\": 12345678,\n      \"blockHash\": \"abc123def456\",\n      \"blockHeight\": 9876543,\n      \"index\": 0,\n      \"fee\": 200000,\n      \"outputAddresses\": [\"addr_test1...\"],\n      \"isGovernance\": true\n    }\n  },\n  \"cardanoSlot\": 12345678,\n  \"cardanoBlock\": \"abc123def456\",\n  \"cardanoBlockHeight\": 9876543,\n  \"cardanoEra\": \"Conway\",\n  \"cardanoNetwork\": \"preprod\"\n}"
            },
            "url": {
              "raw": "http://{{dapr_host}}:{{dapr_http_port}}/v1.0/publish/{{pubsub_name}}/{{topic_name}}",
              "protocol": "http",
              "host": ["{{dapr_host}}"],
              "port": "{{dapr_http_port}}",
              "path": ["v1.0", "publish", "{{pubsub_name}}", "{{topic_name}}"]
            },
            "description": "Publish a blockchain event in CloudEvents format to the pub/sub topic.\n\nThis demonstrates how the BlockchainEventsWorker publishes filtered transactions."
          },
          "response": []
        },
        {
          "name": "Publish Raw JSON (No CloudEvents Envelope)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"transactionId\": \"test-tx-456\",\n  \"slot\": 12345679,\n  \"blockHeight\": 9876544,\n  \"ruleId\": \"address-match\",\n  \"ruleName\": \"Address Match\",\n  \"matchedCriteria\": {\n    \"matched_addresses\": \"addr_test1qz...\"\n  }\n}"
            },
            "url": {
              "raw": "http://{{dapr_host}}:{{dapr_http_port}}/v1.0/publish/{{pubsub_name}}/{{topic_name}}?metadata.rawPayload=true",
              "protocol": "http",
              "host": ["{{dapr_host}}"],
              "port": "{{dapr_http_port}}",
              "path": ["v1.0", "publish", "{{pubsub_name}}", "{{topic_name}}"],
              "query": [
                {
                  "key": "metadata.rawPayload",
                  "value": "true"
                }
              ]
            },
            "description": "Publish a raw JSON payload without CloudEvents envelope.\n\nUse `?metadata.rawPayload=true` to skip the CloudEvents wrapper."
          },
          "response": []
        }
      ]
    },
    {
      "name": "State Management",
      "item": [
        {
          "name": "Get Sync Checkpoint",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://{{dapr_host}}:{{dapr_http_port}}/v1.0/state/{{statestore_name}}/sync-checkpoint",
              "protocol": "http",
              "host": ["{{dapr_host}}"],
              "port": "{{dapr_http_port}}",
              "path": ["v1.0", "state", "{{statestore_name}}", "sync-checkpoint"]
            },
            "description": "Retrieve the current sync checkpoint from the state store.\n\nThis shows the last processed block position for crash recovery."
          },
          "response": []
        },
        {
          "name": "Save Sync Checkpoint",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "[\n  {\n    \"key\": \"sync-checkpoint\",\n    \"value\": {\n      \"slot\": 12345678,\n      \"blockHash\": \"abc123def456\",\n      \"blockHeight\": 9876543,\n      \"processedAt\": \"2026-01-25T10:00:00Z\",\n      \"transactionsProcessed\": 1000,\n      \"eventsEmitted\": 50\n    }\n  }\n]"
            },
            "url": {
              "raw": "http://{{dapr_host}}:{{dapr_http_port}}/v1.0/state/{{statestore_name}}",
              "protocol": "http",
              "host": ["{{dapr_host}}"],
              "port": "{{dapr_http_port}}",
              "path": ["v1.0", "state", "{{statestore_name}}"]
            },
            "description": "Save a sync checkpoint to the state store.\n\nDemonstrates how any consumer can maintain their own processing state."
          },
          "response": []
        },
        {
          "name": "Delete Checkpoint",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "http://{{dapr_host}}:{{dapr_http_port}}/v1.0/state/{{statestore_name}}/sync-checkpoint",
              "protocol": "http",
              "host": ["{{dapr_host}}"],
              "port": "{{dapr_http_port}}",
              "path": ["v1.0", "state", "{{statestore_name}}", "sync-checkpoint"]
            },
            "description": "Delete the sync checkpoint (for testing/reset purposes)."
          },
          "response": []
        },
        {
          "name": "Bulk Get State",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"keys\": [\"sync-checkpoint\", \"last-processed-tx\", \"consumer-offset\"]\n}"
            },
            "url": {
              "raw": "http://{{dapr_host}}:{{dapr_http_port}}/v1.0/state/{{statestore_name}}/bulk",
              "protocol": "http",
              "host": ["{{dapr_host}}"],
              "port": "{{dapr_http_port}}",
              "path": ["v1.0", "state", "{{statestore_name}}", "bulk"]
            },
            "description": "Retrieve multiple state values in a single request."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Secrets",
      "item": [
        {
          "name": "Get Ogmios Credentials",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://{{dapr_host}}:{{dapr_http_port}}/v1.0/secrets/{{secretstore_name}}/ogmios",
              "protocol": "http",
              "host": ["{{dapr_host}}"],
              "port": "{{dapr_http_port}}",
              "path": ["v1.0", "secrets", "{{secretstore_name}}", "ogmios"]
            },
            "description": "Retrieve Ogmios connection credentials from the secret store.\n\nShows how to securely access sensitive configuration."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Consumer Simulation",
      "item": [
        {
          "name": "Simulate Event Subscription Response (SUCCESS)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"SUCCESS\"\n}"
            },
            "url": {
              "raw": "http://localhost:4001/events",
              "protocol": "http",
              "host": ["localhost"],
              "port": "4001",
              "path": ["events"]
            },
            "description": "Example response a consumer would return to acknowledge successful event processing.\n\nDapr expects: {\"status\": \"SUCCESS\"}, {\"status\": \"RETRY\"}, or {\"status\": \"DROP\"}"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Worker HTTP Endpoints",
      "description": "Direct HTTP endpoints exposed by the BlockchainEvents worker service on port 4000.",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://{{worker_host}}:{{worker_http_port}}/health",
              "protocol": "http",
              "host": ["{{worker_host}}"],
              "port": "{{worker_http_port}}",
              "path": ["health"]
            },
            "description": "Returns the current health status of the BlockchainEvents worker."
          },
          "response": []
        },
        {
          "name": "Prometheus Metrics",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://{{worker_host}}:{{worker_http_port}}/metrics",
              "protocol": "http",
              "host": ["{{worker_host}}"],
              "port": "{{worker_http_port}}",
              "path": ["metrics"]
            },
            "description": "Prometheus metrics endpoint exposing 9 custom blockchain event metrics including blocks_processed_total, events_emitted_total, processing_latency_seconds, etc."
          },
          "response": []
        },
        {
          "name": "OpenAPI Spec (JSON)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://{{worker_host}}:{{worker_http_port}}/swagger/v1/swagger.json",
              "protocol": "http",
              "host": ["{{worker_host}}"],
              "port": "{{worker_http_port}}",
              "path": ["swagger", "v1", "swagger.json"]
            },
            "description": "Download the OpenAPI 3.0 specification for the BlockchainEvents API."
          },
          "response": []
        },
        {
          "name": "Swagger UI",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://{{worker_host}}:{{worker_http_port}}/swagger",
              "protocol": "http",
              "host": ["{{worker_host}}"],
              "port": "{{worker_http_port}}",
              "path": ["swagger"]
            },
            "description": "Opens the interactive Swagger UI for exploring the API."
          },
          "response": []
        }
      ]
    },
    {
      "name": "gRPC - Streaming (grpcurl examples)",
      "description": "gRPC server-streaming examples using grpcurl. The gRPC endpoint runs on port {{grpc_port}} with HTTP/2.\n\nPrerequisite: Install grpcurl (brew install grpcurl)\n\nThese are shell commands — Postman does not natively support gRPC streaming, so use grpcurl or a gRPC client.",
      "item": [
        {
          "name": "List gRPC Services",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "// Run in terminal:\n// grpcurl -plaintext -import-path . -proto protos/blockchain_events.proto localhost:{{grpc_port}} list"
            },
            "url": {
              "raw": "http://{{worker_host}}:{{grpc_port}}",
              "protocol": "http",
              "host": ["{{worker_host}}"],
              "port": "{{grpc_port}}"
            },
            "description": "List available gRPC services.\n\n**Shell command:**\n```bash\ngrpcurl -plaintext -import-path . -proto protos/blockchain_events.proto localhost:4010 list\n```\n\nExpected output:\n```\nblockchain_events.BlockchainEventService\n```"
          },
          "response": []
        },
        {
          "name": "Get gRPC Service Status",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "// Run in terminal:\n// grpcurl -plaintext -import-path . -proto protos/blockchain_events.proto localhost:{{grpc_port}} blockchain_events.BlockchainEventService/GetStatus"
            },
            "url": {
              "raw": "http://{{worker_host}}:{{grpc_port}}",
              "protocol": "http",
              "host": ["{{worker_host}}"],
              "port": "{{grpc_port}}"
            },
            "description": "Get current service status including active gRPC subscribers and uptime.\n\n**Shell command:**\n```bash\ngrpcurl -plaintext -import-path . -proto protos/blockchain_events.proto localhost:4010 blockchain_events.BlockchainEventService/GetStatus\n```\n\nExpected output:\n```json\n{\n  \"activeGrpcSubscribers\": 0,\n  \"uptime\": \"0.01:23:45\"\n}\n```"
          },
          "response": []
        },
        {
          "name": "Subscribe to All Events (streaming)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "// Run in terminal (streams until Ctrl+C):\n// grpcurl -plaintext -import-path . -proto protos/blockchain_events.proto -d '{}' localhost:{{grpc_port}} blockchain_events.BlockchainEventService/Subscribe"
            },
            "url": {
              "raw": "http://{{worker_host}}:{{grpc_port}}",
              "protocol": "http",
              "host": ["{{worker_host}}"],
              "port": "{{grpc_port}}"
            },
            "description": "Subscribe to all blockchain events via gRPC server-side streaming. Events are delivered as protobuf BlockchainEventMessage with identical data to HTTP/Dapr.\n\n**Shell command:**\n```bash\ngrpcurl -plaintext -import-path . -proto protos/blockchain_events.proto \\\n  -d '{}' localhost:4010 blockchain_events.BlockchainEventService/Subscribe\n```"
          },
          "response": []
        },
        {
          "name": "Subscribe with Rule Filter (streaming)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "// Run in terminal (streams until Ctrl+C):\n// grpcurl -plaintext -import-path . -proto protos/blockchain_events.proto -d '{\"rule_filter\": \"address-match\"}' localhost:{{grpc_port}} blockchain_events.BlockchainEventService/Subscribe"
            },
            "url": {
              "raw": "http://{{worker_host}}:{{grpc_port}}",
              "protocol": "http",
              "host": ["{{worker_host}}"],
              "port": "{{grpc_port}}"
            },
            "description": "Subscribe to events matching a specific rule only.\n\n**Shell command:**\n```bash\ngrpcurl -plaintext -import-path . -proto protos/blockchain_events.proto \\\n  -d '{\"rule_filter\": \"address-match\"}' \\\n  localhost:4010 blockchain_events.BlockchainEventService/Subscribe\n```\n\nAvailable rule filters:\n- `address-match`\n- `governance-treasury`\n- `metadata-key-value`\n- `policy-id-asset`\n- `all-transactions`"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Redelivery & Recovery Scenarios",
      "description": "Demonstrates at-least-once delivery guarantees and checkpoint-based recovery. These are Docker Compose commands to run in a terminal.",
      "item": [
        {
          "name": "Redelivery Demo (kill & restart consumer)",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "// Run the guided demo: ./tools/milestone-2-demo.sh\n//\n// Manual steps:\n// 1. docker compose up -d\n// 2. Wait for events to flow\n// 3. docker compose stop demo-subscriber\n// 4. Wait 60s (events queue in Redis Streams)\n// 5. docker compose start demo-subscriber\n// 6. docker compose logs demo-subscriber  (observe redelivered events)"
            },
            "url": {
              "raw": "http://{{worker_host}}:{{worker_http_port}}/health",
              "protocol": "http",
              "host": ["{{worker_host}}"],
              "port": "{{worker_http_port}}",
              "path": ["health"]
            },
            "description": "Demonstrates at-least-once delivery by killing the consumer and verifying events are redelivered on restart.\n\n**Guided demo:**\n```bash\n./tools/milestone-2-demo.sh\n```\n\nDemo 4 will:\n1. Start the full Docker Compose stack\n2. Let events flow for 10 seconds\n3. Kill the demo-subscriber container\n4. Wait 20 seconds for events to queue\n5. Restart the subscriber\n6. Show redelivered events in logs"
          },
          "response": []
        },
        {
          "name": "Restart Demo (kill & restart worker)",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "// Run the guided demo: ./tools/milestone-2-demo.sh\n//\n// Manual steps:\n// 1. docker compose up -d\n// 2. Wait for blocks to process\n// 3. Read checkpoint: curl http://localhost:3500/v1.0/state/statestore/sync-checkpoint\n// 4. docker compose stop blockchain-events blockchain-events-dapr\n// 5. Wait 30s\n// 6. docker compose start blockchain-events-dapr blockchain-events\n// 7. docker compose logs blockchain-events  (observe 'Resuming from checkpoint')"
            },
            "url": {
              "raw": "http://{{worker_host}}:{{worker_http_port}}/health",
              "protocol": "http",
              "host": ["{{worker_host}}"],
              "port": "{{worker_http_port}}",
              "path": ["health"]
            },
            "description": "Demonstrates checkpoint-based recovery by killing the worker and verifying it resumes from the last saved slot.\n\n**Guided demo:**\n```bash\n./tools/milestone-2-demo.sh\n```\n\nDemo 5 will:\n1. Start the full stack and let it process blocks\n2. Read the checkpoint from Dapr state store\n3. Kill the worker container\n4. Restart and observe resume from last checkpoint (not genesis)"
          },
          "response": []
        },
        {
          "name": "Check Redis Stream Depth",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "// Run in terminal:\n// docker compose exec redis redis-cli XLEN cardano-transactions\n//\n// This shows how many messages are in the Redis Stream backing the pub/sub topic."
            },
            "url": {
              "raw": "http://{{worker_host}}:{{worker_http_port}}/health",
              "protocol": "http",
              "host": ["{{worker_host}}"],
              "port": "{{worker_http_port}}",
              "path": ["health"]
            },
            "description": "Check the depth of the Redis Stream backing the Dapr pub/sub topic. Useful for verifying messages are queuing during consumer downtime.\n\n```bash\ndocker compose exec redis redis-cli XLEN cardano-transactions\n```"
          },
          "response": []
        }
      ]
    }
  ]
}
